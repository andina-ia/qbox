      /* ===== CLIENTES ===== */
      let clients = [];
      function loadClients() {
        const saved = CONFIG.clients;
        clients = saved && Array.isArray(saved)
          ? saved.map((cl) => (typeof cl === 'string' ? { name: cl, active: true } : cl))
          : DEF.clients.map((cl) => ({ ...cl }));
        renderClients();
      }
      function renderClients() {
        const list = document.getElementById('clients-list');
        list.innerHTML = '';
        clients.forEach((cl, i) => {
          const item = document.createElement('div');
          item.className = 'client-item' + (cl.active ? '' : ' inactive');
          item.draggable = true;
          item.dataset.index = i;
          item.innerHTML = `
            <div class="client-check ${cl.active ? 'checked' : ''}" onclick="toggleClient(${i})" title="${cl.active ? 'Ocultar' : 'Mostrar'}"></div>
            <span class="client-name">${cl.name}</span>
            <button class="btn-sm btn-danger" onclick="removeClient(${i})" title="Eliminar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
            </button>
            <span class="client-handle" title="Arrastrar para reordenar">⠿</span>
          `;
          item.addEventListener('dragstart', (e) => { e.dataTransfer.setData('text/plain', i); item.style.opacity = '.4'; });
          item.addEventListener('dragend', () => (item.style.opacity = '1'));
          item.addEventListener('dragover', (e) => e.preventDefault());
          item.addEventListener('drop', (e) => {
            e.preventDefault();
            const from = parseInt(e.dataTransfer.getData('text/plain'));
            const to = i;
            if (from === to) return;
            const moved = clients.splice(from, 1)[0];
            clients.splice(to, 0, moved);
            renderClients();
          });
          list.appendChild(item);
        });
      }
      function toggleClient(i) { clients[i].active = !clients[i].active; renderClients(); }
      function removeClient(i) { if (!confirm(`¿Eliminar "${clients[i].name}"?`)) return; clients.splice(i, 1); renderClients(); }
