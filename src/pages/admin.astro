      /* Máximo del eje Y para 4 divisiones con números enteros y redondos. */
      function niceMax(v) {
        const raw = Math.max(1, v / 4);
        const p = Math.pow(10, Math.floor(Math.log10(raw)));
        for (const m of [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10]) {
          const step = m * p;
          if (step >= raw && Number.isInteger(step)) return step * 4;
        }
        return 40 * p;
      }

      let chartPts = [];
      function renderChart() {
        const canvas = document.getElementById('chart-main');
        const empty = document.getElementById('chart-empty');
        if (!canvas) return;
        const data = chartData;
        if (!data.length || !data.some((r) => r.visits || r.cotizador || r.contacts)) {
          canvas.style.display = 'none'; empty.style.display = 'block'; return;
        }
        canvas.style.display = 'block'; empty.style.display = 'none';
        const visible = SERIES.filter((s) => !hiddenSeries.has(s.key));
        const maxVal = niceMax(Math.max(1, ...data.flatMap((r) => visible.map((s) => r[s.key]))));
        const ctx = canvas.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        const W = canvas.offsetWidth, H = 240;
        canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const PAD = { top: 14, right: 14, bottom: 34, left: 40 };
        const cW = W - PAD.left - PAD.right, cH = H - PAD.top - PAD.bottom;
        const n = data.length;
        const xAt = (i) => PAD.left + (n === 1 ? cW / 2 : (i / (n - 1)) * cW);
        const yAt = (v) => PAD.top + cH - (v / maxVal) * cH;
        ctx.clearRect(0, 0, W, H);

        ctx.font = '11px system-ui'; ctx.lineWidth = 1;
        for (let i = 0; i <= 4; i++) {
          const val = (maxVal / 4) * (4 - i), y = PAD.top + (cH / 4) * i;
          ctx.strokeStyle = 'rgba(30,32,34,.08)'; ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + cW, y); ctx.stroke();
          ctx.fillStyle = '#8C7E74'; ctx.textAlign = 'right'; ctx.fillText(Number.isInteger(val) ? val : val.toFixed(1), PAD.left - 8, y + 4);
        }
        const step = Math.max(1, Math.ceil(n / 10));
        ctx.textAlign = 'center'; ctx.fillStyle = '#8C7E74';
        data.forEach((r, i) => {
          if (i % step === 0 || i === n - 1) {
            const [, mm, dd] = r.date.split('-');
            ctx.fillText(`${+dd}/${+mm}`, xAt(i), H - 10);
          }
        });

        visible.forEach((s) => {
          const pts = data.map((r, i) => ({ x: xAt(i), y: yAt(r[s.key]) }));
          ctx.beginPath();
          pts.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
          ctx.strokeStyle = s.color; ctx.lineWidth = 2.5; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.stroke();
          if (n <= 31) pts.forEach((p) => { ctx.beginPath(); ctx.arc(p.x, p.y, 4, 0, Math.PI * 2); ctx.fillStyle = s.color; ctx.fill(); ctx.strokeStyle = '#FAF9F5'; ctx.lineWidth = 1.5; ctx.stroke(); });
        });
        chartPts = data.map((r, i) => ({ x: xAt(i), r }));
      }

      /* Tooltip: al pasar el mouse muestra los 3 valores del día */
      (function initChartTip() {
        const canvas = document.getElementById('chart-main');
        const tip = document.getElementById('chart-tip');
        if (!canvas || !tip) return;
        const hide = () => (tip.style.display = 'none');
        canvas.addEventListener('mouseleave', hide);
        canvas.addEventListener('mousemove', (ev) => {
          if (!chartPts.length) return;
          const rect = canvas.getBoundingClientRect();
          const x = ev.clientX - rect.left;
          const near = chartPts.reduce((a, b) => (Math.abs(b.x - x) < Math.abs(a.x - x) ? b : a));
          const [yy, mm, dd] = near.r.date.split('-');
          tip.innerHTML = `<strong>${+dd}/${+mm}/${yy}</strong><br>` + SERIES.filter((s) => !hiddenSeries.has(s.key))
            .map((s) => `<span style="color:${s.color}">●</span> ${s.label}: ${fmtN(near.r[s.key])}`).join('<br>');
          tip.style.display = 'block';
          const left = Math.min(Math.max(near.x + 12, 0), rect.width - tip.offsetWidth - 4);
          tip.style.left = left + 'px'; tip.style.top = '8px';
        });
        window.addEventListener('resize', () => { if (chartData.length) renderChart(); });
      })();

