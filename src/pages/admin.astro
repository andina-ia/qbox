        all[seoPage] = {
          title: document.getElementById('f-seo-title').value,
          desc: document.getElementById('f-seo-desc').value,
          keywords: document.getElementById('f-seo-kw').value
        };
        try { await saveSection('seo', all); toast('SEO guardado · ya está publicado'); }
        catch (e) { toast(e.message, true); }
      }

      /* ===== MEDIOS ===== */
      let mediaCat = 'modulos';
      function loadMedia() {
        const pillsEl = document.getElementById('media-pills');
        pillsEl.innerHTML = '';
        MEDIA_CATS.forEach(([key, label]) => {
          const b = document.createElement('button');
          b.className = 'pill' + (key === mediaCat ? ' active' : '');
          b.textContent = label;
          b.onclick = () => {
            mediaCat = key;
            document.querySelectorAll('#media-pills .pill').forEach((p) => p.classList.remove('active'));
            b.classList.add('active');
            loadExistingImages();
          };
          pillsEl.appendChild(b);
        });
        loadExistingImages();
      }
      /* Fotos originales de cada galería (las mismas que usa la página pública). */
      const DEFAULT_GALLERIES = JSON.parse(document.getElementById('admin-galleries').textContent);
      /** Lista que el sitio muestra HOY para una categoría: la editada en el admin o, si no hay, la original. */
      function currentList(cat) {
        const m = (CONFIG.media || {})[cat];
        return Array.isArray(m) && m.length ? m.slice() : (DEFAULT_GALLERIES[cat] || []).slice();
      }
      function isCustomized(cat) {
        const m = (CONFIG.media || {})[cat];
        return Array.isArray(m) && m.length > 0;
      }
      async function saveList(cat, list, msg) {
        const all = { ...(CONFIG.media || {}) };
        all[cat] = list;
        await saveSection('media', all);
        loadExistingImages();
        if (msg) toast(msg);
      }
      /** Borra del servidor un archivo subido que ya no se usa en ninguna galería. */
      function cleanupFile(url) {
        if (!url || !url.startsWith('/uploads/')) return;
        const used = Object.keys(DEFAULT_GALLERIES).some((c) => currentList(c).includes(url) || currentCover(c) === url);
        if (!used) api('/api/upload.php', { method: 'POST', body: JSON.stringify({ action: 'delete', url }) }).catch(() => {});
      }
      const btnStyle = 'width:28px;height:28px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:14px;line-height:1;';
      /* ===== PORTADAS (tarjetas "Proyectos terminados" del inicio) ===== */
      const DEFAULT_COVERS = JSON.parse(document.getElementById('admin-covers').textContent);
      let pickingCover = false;
      function currentCover(cat) {
        const c = (CONFIG.covers || {})[cat];
        return typeof c === 'string' && c ? c : DEFAULT_COVERS[cat] || '';
      }
      function renderCover() {
        const box = document.getElementById('cover-box');
        const url = currentCover(mediaCat);
        const custom = !!(CONFIG.covers || {})[mediaCat];
        const label = MEDIA_CATS.find((c) => c[0] === mediaCat)?.[1] || mediaCat;
        const b = 'font-size:13px;font-weight:600;border-radius:100px;padding:8px 16px;cursor:pointer;font-family:inherit;';
        box.innerHTML = `
          <p class="lbl" style="margin-bottom:10px;">Portada en el inicio</p>
          <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap;background:var(--card);border:1.5px solid var(--border);border-radius:16px;padding:16px;">
            <div style="position:relative;width:260px;max-width:100%;aspect-ratio:16/10;border-radius:12px;overflow:hidden;background:#1E2022 center/cover no-repeat;background-image:url('${url}');">
              <div style="position:absolute;inset:0;background:linear-gradient(transparent 40%,rgba(0,0,0,.65));"></div>
              <span style="position:absolute;left:12px;bottom:10px;color:#fff;font-family:var(--serif);font-size:18px;">${label}</span>
            </div>
            <div style="flex:1;min-width:220px;">
              <p style="font-size:13.5px;color:var(--accent);margin-bottom:12px;line-height:1.5;">Es la foto de la tarjeta de ${label} en la sección “Proyectos terminados” del inicio. ${custom ? 'Tiene una portada personalizada.' : 'Hoy muestra la foto original.'}</p>
              <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button onclick="document.getElementById('cover-input').value='';document.getElementById('cover-input').click()" style="${b}background:var(--ink);color:#fff;border:none;">Subir foto nueva</button>
                <button onclick="togglePickCover()" style="${b}background:none;border:1.5px solid var(--border);color:var(--ink);">${pickingCover ? 'Cancelar' : 'Elegir de la galería'}</button>
                ${custom ? `<button onclick="restoreCover()" style="${b}background:none;border:1.5px solid var(--border);color:var(--ink);">↺ Restaurar original</button>` : ''}
              </div>
              ${pickingCover ? '<p style="font-size:13px;font-weight:600;color:#B4452F;margin-top:10px;">Hacé clic en una foto de la galería de abajo para usarla como portada.</p>' : ''}
            </div>
          </div>`;
      }
      async function setCover(url, msg) {
        const prev = currentCover(mediaCat);
        const all = { ...(CONFIG.covers || {}) };
        if (url) all[mediaCat] = url; else delete all[mediaCat];
        await saveSection('covers', all);
        pickingCover = false;
        loadExistingImages();
        toast(msg);
        if (prev !== currentCover(mediaCat)) cleanupFile(prev);
      }
      function togglePickCover() { pickingCover = !pickingCover; loadExistingImages(); }
      async function pickCover(i) {
        try { await setCover(currentList(mediaCat)[i], 'Portada actualizada · ya está publicado'); }
        catch (e) { toast(e.message, true); }
      }
      async function restoreCover() {
        try { await setCover('', 'Portada original restaurada'); } catch (e) { toast(e.message, true); }
      }
      async function handleCoverFile(input) {
        const file = input.files && input.files[0];
        if (!file) return;
        if (!file.type.startsWith('image/')) { toast('El archivo no es una imagen', true); return; }
        if (file.size > 8 * 1024 * 1024) { toast(`${file.name} supera los 8 MB`, true); return; }
        toast('Subiendo portada...');
        try { await setCover(await uploadToServer(file), 'Portada actualizada · ya está publicado'); }
        catch (e) { toast(e.message, true); }
      }

      function loadExistingImages() {
        renderCover();
        const arr = currentList(mediaCat);
        const el = document.getElementById('existing-images');
        const label = MEDIA_CATS.find((c) => c[0] === mediaCat)?.[1] || mediaCat;
        const custom = isCustomized(mediaCat);
        const head = `<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px;">
            <p class="lbl" style="margin:0;">Publicadas en ${label} (${arr.length})</p>
            ${custom ? `<button onclick="restoreDefaults()" style="font-size:12.5px;font-weight:600;background:none;border:1.5px solid var(--border);border-radius:100px;padding:6px 14px;cursor:pointer;color:var(--ink);">↺ Restaurar fotos originales</button>` : ''}
          </div>`;
        if (!arr.length) { el.innerHTML = head + '<p style="font-size:14px;color:var(--accent);">No hay imágenes en esta categoría todavía.</p>'; return; }
        el.innerHTML = head + `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;">
            ${arr.map((url, i) => {
              const tag = url.startsWith('/uploads/') ? 'Subida' : 'Original';
              return `
              <div style="position:relative;border-radius:12px;overflow:hidden;aspect-ratio:1;background:var(--border);${pickingCover ? 'outline:3px solid #B4452F;outline-offset:-3px;cursor:pointer;' : ''}${url === currentCover(mediaCat) ? 'box-shadow:0 0 0 3px var(--ink);' : ''}">
                <img src="${url}" style="width:100%;height:100%;object-fit:cover;cursor:zoom-in;" loading="lazy" onclick="${pickingCover ? `pickCover(${i})` : `window.open('${url}','_blank')`}" onerror="this.parentElement.style.opacity='.3'">
                <span style="position:absolute;top:6px;left:6px;font-size:11px;font-weight:700;background:rgba(30,32,34,.8);color:#fff;border-radius:100px;padding:3px 8px;">${i === 0 ? '★ ' : ''}${i + 1} · ${url === currentCover(mediaCat) ? 'Portada' : tag}</span>
                <button onclick="removeImage(${i})" title="Eliminar" style="${btnStyle}position:absolute;top:6px;right:6px;background:rgba(180,69,47,.92);color:#fff;">×</button>
                <div style="position:absolute;left:0;right:0;bottom:0;display:flex;gap:6px;justify-content:center;align-items:center;padding:8px;background:linear-gradient(transparent,rgba(0,0,0,.55));">
                  <button onclick="moveImage(${i},-1)" title="Mover antes" ${i === 0 ? 'disabled' : ''} style="${btnStyle}background:#fff;opacity:${i === 0 ? '.35' : '1'};">←</button>
                  <button onclick="startReplace(${i})" title="Reemplazar esta foto" style="height:28px;border-radius:100px;border:none;cursor:pointer;background:#fff;font-size:12px;font-weight:700;padding:0 12px;">Reemplazar</button>
                  <button onclick="moveImage(${i},1)" title="Mover después" ${i === arr.length - 1 ? 'disabled' : ''} style="${btnStyle}background:#fff;opacity:${i === arr.length - 1 ? '.35' : '1'};">→</button>
                </div>
              </div>`; }).join('')}
          </div>
          <p style="font-size:12.5px;color:var(--accent);margin-top:10px;">La foto ★ Principal es la que aparece primero y más grande en la galería. Hacé clic en una foto para verla completa.</p>`;
      }
      async function removeImage(i) {
        const arr = currentList(mediaCat);
        if (arr.length <= 1) { toast('La galería necesita al menos una foto. Usá “Reemplazar”.', true); return; }
        if (!confirm(`¿Eliminar la foto ${i + 1} de la galería?`)) return;
        const [removed] = arr.splice(i, 1);
        try { await saveList(mediaCat, arr, 'Foto eliminada · ya está publicado'); cleanupFile(removed); }
        catch (e) { toast(e.message, true); }
      }
      async function moveImage(i, dir) {
        const arr = currentList(mediaCat);
        const j = i + dir;
        if (j < 0 || j >= arr.length) return;
        [arr[i], arr[j]] = [arr[j], arr[i]];
        try { await saveList(mediaCat, arr, 'Orden guardado · ya está publicado'); }
        catch (e) { toast(e.message, true); }
      }
      async function restoreDefaults() {
        if (!confirm('¿Volver a las fotos originales de esta categoría? Se descarta el orden y las fotos que hayas cambiado.')) return;
        const prev = currentList(mediaCat);
        try {
          await saveList(mediaCat, [], 'Fotos originales restauradas');
          prev.forEach(cleanupFile);
        } catch (e) { toast(e.message, true); }
      }
      let replaceIdx = null;
      function startReplace(i) {
        replaceIdx = i;
        const inp = document.getElementById('replace-input');
        inp.value = '';
        inp.click();
      }
      async function handleReplace(input) {
        const file = input.files && input.files[0];
        if (!file || replaceIdx === null) return;
        if (!file.type.startsWith('image/')) { toast('El archivo no es una imagen', true); return; }
        if (file.size > 8 * 1024 * 1024) { toast(`${file.name} supera los 8 MB`, true); return; }
        const i = replaceIdx; replaceIdx = null;
        toast('Subiendo foto nueva...');
        try {
          const url = await uploadToServer(file);
          const arr = currentList(mediaCat);
          const old = arr[i];
          arr[i] = url;
          await saveList(mediaCat, arr, 'Foto reemplazada · ya está publicado');
          cleanupFile(old);
        } catch (e) { toast(e.message, true); }
      }
      async function uploadToServer(file) {
        const fd = new FormData();
        fd.append('file', file);
        fd.append('category', mediaCat);
        const resp = await api('/api/upload.php', { method: 'POST', body: fd });
        const data = await resp.json().catch(() => ({}));
        if (!resp.ok || !data.url) throw new Error(data.error || 'No se pudo subir la imagen');
        return data.url;
      }
      function handleDrop(e) {
        e.preventDefault();
        document.getElementById('drop-zone').style.borderColor = 'var(--border)';
        handleFiles(e.dataTransfer.files);
      }
      function handleFiles(files) {
        if (!files || files.length === 0) return;
        Array.from(files).forEach((file) => {
          if (!file.type.startsWith('image/')) return;
          if (file.size > 8 * 1024 * 1024) { alert(`${file.name} supera los 8 MB`); return; }
          queueUpload(file);
        });
      }
      let uploadChain = Promise.resolve();
      function queueUpload(file) {
        const id = 'q' + Date.now() + Math.random().toString(36).slice(2);
        const queue = document.getElementById('upload-queue');
        const item = document.createElement('div');
        item.id = id;
        item.style.cssText = 'display:flex;align-items:center;gap:12px;background:var(--card);border:1.5px solid var(--border);border-radius:12px;padding:10px 14px;';
        item.innerHTML = `
          <div style="width:40px;height:40px;border-radius:8px;background:var(--border);overflow:hidden;flex-shrink:0;">
            <img id="prev-${id}" style="width:100%;height:100%;object-fit:cover;">
          </div>
          <div style="flex:1;min-width:0;">
            <p style="font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${file.name}</p>
            <p id="status-${id}" style="font-size:12px;color:var(--accent);margin-top:2px;">Preparando...</p>
          </div>
          <div id="prog-${id}" style="width:60px;height:4px;background:var(--border);border-radius:2px;overflow:hidden;">
            <div id="bar-${id}" style="height:100%;width:0%;background:var(--ink);transition:width .3s;"></div>
          </div>`;
        queue.appendChild(item);
        const reader = new FileReader();
        reader.onload = (e) => (document.getElementById('prev-' + id).src = e.target.result);
        reader.readAsDataURL(file);
        // En fila: cada subida guarda la galería con la anterior ya incluida.
        uploadChain = uploadChain.then(() => uploadFile(file, id));
      }
      async function uploadFile(file, id) {
        const setStatus = (msg, color = 'var(--accent)') => { const el = document.getElementById('status-' + id); if (el) { el.textContent = msg; el.style.color = color; } };
        const setBar = (pct) => { const el = document.getElementById('bar-' + id); if (el) el.style.width = pct + '%'; };
        try {
          setStatus('Subiendo...'); setBar(40);
          const cat = mediaCat;
          const url = await uploadToServer(file);
          setBar(85);
          // Se suma a lo que ya está publicado (originales incluidas), no las reemplaza.
          const arr = currentList(cat);
          arr.push(url);
          const all = { ...(CONFIG.media || {}) };
          all[cat] = arr;
          await saveSection('media', all);
          setBar(100); setStatus('✓ Agregada a la galería', '#2E7D32');
          loadExistingImages();
          setTimeout(() => document.getElementById(id)?.remove(), 2000);
        } catch (err) {
          setStatus('Error: ' + err.message, '#B4452F'); setBar(0);
        }
      }

      /* ===== INIT ===== */
      init();
    </script>
  </body>
</html>
