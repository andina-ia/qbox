---

<BaseLayout seo={seo}>
  <section id="cat-hero">
    <div class="cat-hero-bg" style="background-image:url('/assets/modulos/20260204_103237.webp');"></div>
    <div class="cat-hero-ov"></div>
    <div class="cat-hero-cnt">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Volver al inicio
      </a>
      <p class="cat-kicker">VIVIENDAS · OFICINAS · LLAVE EN MANO</p>
      <h1>Módulos</h1>
      <p class="cat-tagline">Un módulo. Infinitas posibilidades. Vos elegís para qué usarlo, nosotros lo entregamos listo.</p>
    </div>
  </section>

  <section class="mod-main-sec">
    <div class="wrap">
      <div class="mod-main-grid">
        <div class="mod-left rv">
          <h2 class="mod-left-h2">Espacios listos para habitar,<br /><em>desde el primer día.</em></h2>
          <p class="mod-left-p">Construimos con paneles sándwich de poliuretano expandido de alta densidad, estructura metálica y envolvente térmica continua. Sin puentes térmicos, sin sorpresas. Cada módulo sale de nuestro taller y llega listo para conectar agua, luz y usar.</p>
          <p class="mod-left-p">Operan en condiciones severas: desde -15°C hasta +35°C, resistencia a vientos fuertes y cargas de nieve en cubierta.</p>
          <div class="mod-stats-grid">
            <div class="mod-stat"><span class="mod-stat-val">120+</span><span class="mod-stat-lbl">Proyectos entregados</span></div>
            <div class="mod-stat"><span class="mod-stat-val">60mm</span><span class="mod-stat-lbl">Panel aislante</span></div>
            <div class="mod-stat"><span class="mod-stat-val">120km/h</span><span class="mod-stat-lbl">Resist. al viento</span></div>
            <div class="mod-stat"><span class="mod-stat-val">-15°C</span><span class="mod-stat-lbl">Temp. mínima</span></div>
          </div>
          <a class="mod-ficha-btn" href="/assets/modulos/FICHA_TECNICA_QBOX.pdf" download="Ficha_Tecnica_qBox.pdf">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="12" x2="12" y2="18"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
            Descargar ficha técnica
          </a>
        </div>

        <div class="mod-right rv d1">
          <h2 class="mod-right-h2">Elegí tu prototipo</h2>
          <p class="mod-right-sub">Hacé click en el que te interesa para ver fotos, especificaciones y precio.</p>
          <div class="proto-selector-grid">
            {protos.map((proto, index) => (
              <div
                class="proto-sel-card"
                data-proto={index + 1}
                role="button"
                tabindex="0"
              >
                <div class="proto-sel-img">
                  <img src={proto.heroImg} alt={proto.title} loading={index < 2 ? 'eager' : 'lazy'} />
                  <div class="proto-sel-overlay">
                    <div class="proto-sel-label">
                      <p class="proto-sel-num">{proto.num}</p>
                      <h3 class="proto-sel-title">{proto.title}</h3>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mod-sec mod-cta-sec">
    <div class="wrap" style="text-align:center;">
      <h2>¿Tenés un proyecto en mente?</h2>
      <p style="color:var(--muted);max-width:480px;margin:0 auto 28px;">Contanos qué necesitás y te asesoramos sin compromiso. También podés visitar nuestro showroom en San Juan.</p>
      <a href={waLink('Hola qBox, me interesa conocer más sobre los módulos. Quisiera más información.')} class="btn-p" target="_blank" rel="noopener">Consultá por WhatsApp →</a>
    </div>
  </section>

  <div id="proto-modal" data-close-modal="overlay">
    <div class="proto-modal-inner">
      <button class="proto-modal-close" data-close-modal="btn">✕</button>
      <div id="proto-modal-content"></div>
    </div>
  </div>

  <div class="lb" id="lb" data-close-lb="overlay">
    <button class="lb-close" data-close-lb="btn">×</button>
    <button class="lb-nav lb-prev" data-lb-nav="-1">‹</button>
    <img id="lb-img" src="" alt="" />
    <button class="lb-nav lb-next" data-lb-nav="1">›</button>
  </div>

  <script is:inline define:vars={{ protos }}>
    const PROTOS = protos;
    let lbImgs = [];
    let lbIdx = 0;

    // Event delegation para las cards
    document.addEventListener('DOMContentLoaded', function() {

      // Cerrar modal
      document.querySelectorAll('[data-close-modal]').forEach(function(el) {
        el.addEventListener('click', function(e) {
          if (this.dataset.closeModal === 'overlay' && e.target !== this) return;
          closeProto();
        });
      });

      // Cerrar lightbox
      document.querySelectorAll('[data-close-lb]').forEach(function(el) {
        el.addEventListener('click', function(e) {
          if (this.dataset.closeLb === 'overlay' && e.target !== this) return;
          closeLb();
        });
      });

      // Nav lightbox
      document.querySelectorAll('[data-lb-nav]').forEach(function(el) {
        el.addEventListener('click', function() {
          lbNav(parseInt(this.dataset.lbNav));
        });
      });

      // Cards prototipos
      document.querySelectorAll('[data-proto]').forEach(function(card) {
        card.addEventListener('click', function() {
          openProto(parseInt(this.getAttribute('data-proto')));
        });
        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openProto(parseInt(this.getAttribute('data-proto')));
          }
        });
      });
    });

    function openProto(n) {
      const p = PROTOS[n - 1];
      const badgeHtml = p.badge ? `<span class="proto-sel-badge" style="position:static;margin-bottom:8px;display:inline-block;">${p.badge}</span>` : '';
      const galleryHtml = p.gallery.length > 1
        ? `<div class="pmod-gallery">${p.gallery.map((src, i) => `<div class="pmod-gal-item" onclick="openLbModal(${i}, ${n})"><img src="${src}" alt="${p.title} ${i + 1}" loading="lazy" /></div>`).join('')}</div>`
        : '';

      document.getElementById('proto-modal-content').innerHTML = `
        <div class="pmod-hero">
          <img src="${p.heroImg}" alt="${p.title}" />
          <div class="pmod-hero-ov"></div>
          <div class="pmod-hero-txt">
            <p>${p.num}</p>
            <h2>${p.title}</h2>
          </div>
        </div>
        <div class="pmod-body">
          ${badgeHtml}
          <div class="pmod-price-row">
            <span class="pmod-price">${p.price}</span>
            <span class="pmod-price-sub">+ IVA · ${p.area}</span>
            <span class="pmod-entrega">● Entrega inmediata</span>
          </div>
          <div class="pmod-specs-row">
            <div class="pmod-spec"><span class="pmod-spec-val">${p.area}</span><span class="pmod-spec-lbl">Superficie</span></div>
            <div class="pmod-spec"><span class="pmod-spec-val">${p.dims}</span><span class="pmod-spec-lbl">Dimensiones</span></div>
            <div class="pmod-spec"><span class="pmod-spec-val">${p.altura}</span><span class="pmod-spec-lbl">Altura int.</span></div>
            <div class="pmod-spec"><span class="pmod-spec-val">${p.panel}</span><span class="pmod-spec-lbl">Panel</span></div>
          </div>
          <div class="pmod-usos">${p.usos.map((u) => `<span class="pmod-uso">${u}</span>`).join('')}</div>
          <div class="pmod-grid2">
            <div class="pmod-block">
              <h4>Características</h4>
              <ul>${p.caracteristicas.map((c) => `<li>${c}</li>`).join('')}</ul>
            </div>
            <div class="pmod-block">
              <h4>¿Qué incluye?</h4>
              <ul>${p.incluye.map((i) => `<li>${i}</li>`).join('')}</ul>
            </div>
          </div>
          <p class="pmod-nota">El valor corresponde al prototipo estándar. Terminaciones, equipamiento y personalizaciones se cotizan por separado.</p>
          ${galleryHtml}
          <a class="pmod-cta" href="https://wa.me/5492644431309?text=${encodeURIComponent(p.waMsg)}" target="_blank" rel="noopener">Consultar por WhatsApp →</a>
        </div>
      `;
      lbImgs = p.gallery;
      document.getElementById('proto-modal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeProto() {
      document.getElementById('proto-modal').classList.remove('open');
      document.body.style.overflow = '';
    }

    function openLbModal(i, n) {
      const p = PROTOS[n - 1];
      lbImgs = p.gallery;
      lbIdx = i;
      document.getElementById('lb-img').src = lbImgs[i];
      document.getElementById('lb').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeLb() {
      document.getElementById('lb').classList.remove('open');
      document.body.style.overflow = '';
    }

    function lbNav(dir) {
      lbIdx = (lbIdx + dir + lbImgs.length) % lbImgs.length;
      document.getElementById('lb-img').src = lbImgs[lbIdx];
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeProto();
        closeLb();
      }
      if (e.key === 'ArrowLeft') lbNav(-1);
      if (e.key === 'ArrowRight') lbNav(1);
    });
  </script>

  <style is:global>
    #cat-hero {
      position: relative;
      min-height: 22vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      padding-top: 68px;
      background: #0E0C0A;
    }
      position: relative;
      min-height: 22vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      padding-top: 68px;
      background: #0E0C0A;
    }
    .cat-hero-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      opacity: .45;
      z-index: 0;
    }
    .cat-hero-ov {
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(14, 12, 10, .98) 0%, rgba(14, 12, 10, .75) 45%, rgba(14, 12, 10, .2) 100%);
      z-index: 1;
    }
    .cat-hero-cnt {
      position: relative;
      z-index: 2;
      padding: clamp(12px, 2vw, 20px) var(--px) clamp(12px, 2vw, 20px);
      width: 100%;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13.5px;
      font-weight: 600;
      color: rgba(245, 238, 220, .45);
      text-decoration: none;
      margin-bottom: 8px;
      transition: .2s;
    }
    .back-link:hover { color: rgba(245, 238, 220, .8); }
    .cat-kicker {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: rgba(245, 238, 220, .5);
      margin-bottom: 6px;
    }
    #cat-hero h1 {
      color: #F5EEDC;
      font-size: clamp(20px, 2.5vw, 32px);
      line-height: 1.1;
      margin-bottom: 6px;
    }
    .cat-tagline {
      color: rgba(245, 238, 220, .55);
      font-size: clamp(12px, 1.1vw, 13px);
      max-width: 480px;
    }

    .mod-main-sec {
      background: var(--bg);
      padding: clamp(20px, 2.5vw, 28px) var(--px);
    }
    .mod-main-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(20px, 2.5vw, 36px);
      max-width: var(--max);
      margin: 0 auto;
      align-items: start;
    }
    .mod-left-h2 {
      font-family: var(--serif);
      font-size: clamp(1rem, 1.6vw, 1.3rem);
      font-weight: 400;
      line-height: 1.2;
      color: var(--ink);
      margin-bottom: 10px;
    }
    .mod-left-h2 em { font-style: italic; color: var(--accent); }
    .mod-left-p {
      font-size: 12px;
      color: #6b6560;
      line-height: 1.6;
      margin-bottom: 8px;
    }
    .mod-stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      margin-top: 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }
    .mod-stat {
      text-align: center;
      padding: 10px 6px;
      border-right: 1px solid var(--border);
      background: var(--card);
    }
    .mod-stat:last-child { border-right: none; }
    .mod-stat-val {
      display: block;
      font-family: var(--serif);
      font-size: clamp(0.85rem, 1.4vw, 1.05rem);
      font-weight: 400;
      color: var(--ink);
      margin-bottom: 4px;
    }
    .mod-ficha-btn { display:inline-flex; align-items:center; gap:8px; margin-top:14px; font-family:var(--sans); font-size:12px; font-weight:600; color:var(--ink); border:1.5px solid var(--ink); border-radius:8px; padding:7px 14px; text-decoration:none; transition:background .15s, color .15s; }
.mod-ficha-btn:hover { background:var(--ink); color:var(--bg); }
.mod-stat-lbl {
      font-size: 9px;
      color: var(--accent);
      letter-spacing: .02em;
    }
    .mod-right-h2 {
      font-family: var(--serif);
      font-size: clamp(0.95rem, 1.3vw, 1.15rem);
      font-weight: 400;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .mod-right-sub {
      font-size: 11px;
      color: #6b6560;
      margin-bottom: 12px;
    }
    .proto-selector-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      max-width: 420px;
    }
    .proto-sel-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      cursor: pointer;
      transition: transform .2s, box-shadow .2s;
    }
    .proto-sel-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, .12);
    }
    .proto-sel-img {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
    }
    .proto-sel-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .4s;
    }
    .proto-sel-card:hover .proto-sel-img img { transform: scale(1.04); }
    .proto-sel-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, .75) 0%, rgba(0, 0, 0, .05) 55%, transparent 100%);
      display: flex;
      align-items: flex-end;
      transition: background .3s;
    }
    .proto-sel-card:hover .proto-sel-overlay {
      background: linear-gradient(to top, rgba(0, 0, 0, .88) 0%, rgba(0, 0, 0, .2) 60%, transparent 100%);
    }
    .proto-sel-label { padding: 18px 20px 22px; }
    .proto-sel-num {
      font-size: 9px;
      letter-spacing: .14em;
      color: rgba(255, 255, 255, .65);
      font-weight: 600;
      margin-bottom: 3px;
    }
    .proto-sel-title {
      font-family: var(--serif);
      font-size: 0.8rem;
      font-weight: 400;
      color: #fff;
      line-height: 1.2;
    }

    .mod-sec { padding: clamp(48px, 6vw, 80px) var(--px); }
    .mod-cta-sec {
      background: var(--ink);
      color: #F5F4F0;
    }
    .mod-cta-sec h2 {
      font-family: var(--serif);
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: 400;
      margin-bottom: 14px;
    }

    #proto-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .7);
      z-index: 1000;
      overflow-y: auto;
      padding: 16px;
    }
    #proto-modal.open { display: flex; align-items: center; justify-content: center; }
    .proto-modal-inner {
      background: var(--bg);
      border-radius: 16px;
      max-width: 620px;
      width: 100%;
      position: relative;
      margin: auto;
      overflow: hidden;
      max-height: 88vh;
      overflow-y: auto;
    }
    .proto-modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(0, 0, 0, .12);
      border: none;
      cursor: pointer;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
