---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  seo: { title: string; description?: string; desc?: string; keywords?: string };
  /** Clave de config.seo que el admin puede editar para esta página (ej. 'inicio'). */
  seoKey?: string;
  home?: boolean;
}
const { seo, seoKey, home = false } = Astro.props;
const description = seo.description ?? seo.desc;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <BaseHead title={seo.title} description={description} keywords={seo.keywords}>
      <script is:inline>
        /* ===== CONFIG EN VIVO (MySQL vía /api/config.php) =====
           El HTML trae los valores del build como respaldo; al cargar, se piden los
           valores actuales de la base y se aplican. Las páginas pueden esperar
           `window.QBOX_CFG` (promesa que resuelve al objeto de config o null). */
        window.QBOX_CFG = fetch('/api/config.php', { cache: 'no-store' })
          .then((r) => (r.ok ? r.json() : null))
          .catch(() => null);
      </script>
      <slot name="head" />
    </BaseHead>
  </head>
  <body data-seo-key={seoKey}>
    <Nav home={home} />
    <slot />
    <Footer home={home} />
    <WhatsAppButton />

    <script is:inline>
      /* ===== APLICAR CONFIG EN VIVO ===== */
      window.qboxSetSeo = function (s) {
        if (!s) return;
        if (s.title) document.title = s.title;
        const setMeta = (name, val) => {
          if (!val) return;
          let m = document.querySelector(`meta[name="${name}"]`);
          if (!m) { m = document.createElement('meta'); m.setAttribute('name', name); document.head.appendChild(m); }
          m.setAttribute('content', val);
        };
        setMeta('description', s.desc);
        setMeta('keywords', s.keywords);
      };
      window.QBOX_CFG.then((cfg) => {
        if (!cfg) return;
        const key = document.body.dataset.seoKey;
        if (key && cfg.seo) qboxSetSeo(cfg.seo[key]);
        // Textos simples: <p data-cfg="content.heroSub">
        document.querySelectorAll('[data-cfg]').forEach((el) => {
          const val = el.dataset.cfg.split('.').reduce((o, k) => (o == null ? o : o[k]), cfg);
          if (typeof val === 'string' && val.trim()) el.textContent = val;
        });
      });

      /* ===== ANALYTICS (MySQL vía /api/track.php) ===== */
      window.track = function (type, metadata = {}) {
        try {
          fetch('/api/track.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type, metadata }),
            keepalive: true
          }).catch(() => {});
        } catch (e) {}
      };
      if (!sessionStorage.getItem('qbox_pv')) {
        sessionStorage.setItem('qbox_pv', '1');
        track('page_view', { referrer: document.referrer, path: location.pathname });
      }

      /* ===== MENU ===== */
      let menuOpen = false;
      window.toggleMenu = function () {
        menuOpen = !menuOpen;
        document.getElementById('nav').classList.toggle('open', menuOpen);
      };
      window.closeMenu = function () {
        menuOpen = false;
        document.getElementById('nav').classList.remove('open');
      };

      /* ===== REVEAL ON SCROLL ===== */
      const _ro = new IntersectionObserver(
        (es) => {
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              _ro.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.rv').forEach((el) => _ro.observe(el));
    </script>
  </body>
</html>
